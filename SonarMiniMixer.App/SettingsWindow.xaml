<Window x:Class="SonarMiniMixer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonar Mini Mixer Settings" Icon="Assets/AppIcon.ico" Width="410" Height="252" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" ShowInTaskbar="False"
        AutomationProperties.Name="Sonar Mini Mixer settings">
  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource WindowBrush}">
    <Grid Margin="24,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Mixer settings" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="LOCAL APP PREFERENCES" Foreground="{StaticResource DimTextBrush}" FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0"/>
      </StackPanel>
      <Border Grid.Row="1" Margin="0,20,0,0" Padding="14,12" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6">
        <CheckBox x:Name="StartupCheck" Content="Start Sonar Mini Mixer when I sign in"
                  Foreground="{StaticResource TextBrush}" FontSize="12" VerticalContentAlignment="Center"
                  AutomationProperties.Name="Start Sonar Mini Mixer when I sign in"/>
      </Border>
      <TextBlock Grid.Row="2" Text="This app controls the Sonar services already running on this PC. It does not install drivers, capture audio, or process your sound."
                 TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" LineHeight="17" Margin="0,14,0,0"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Width="82" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
        <Button Style="{StaticResource PrimaryButton}" Content="Save" Width="82" Click="Save_Click" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
