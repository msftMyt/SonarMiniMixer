<Window x:Class="SonarMiniMixer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonar Mini Mixer Settings" Icon="Assets/AppIcon.ico" Width="390" Height="235" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#16141F" Foreground="#F4F1FA" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="SETTINGS" FontSize="16" FontWeight="SemiBold"/>
    <CheckBox x:Name="StartupCheck" Grid.Row="1" Content="Start Sonar Mini Mixer when I sign in" Margin="0,24,0,0" Foreground="#E7E1EC" FontSize="13"/>
    <TextBlock Grid.Row="2" Text="The mixer only connects to SteelSeries services on this PC. It does not install drivers or process audio." TextWrapping="Wrap" Foreground="#9992A8" FontSize="11" Margin="0,16,0,0"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="84" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button Content="Save" Width="84" Height="32" Background="#BD93F9" Foreground="#17131F" FontWeight="SemiBold" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
