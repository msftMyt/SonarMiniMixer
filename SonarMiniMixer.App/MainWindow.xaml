<Window x:Class="SonarMiniMixer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SonarMiniMixer.App"
        Title="Sonar Mini Mixer" Icon="Assets/AppIcon.ico" Width="864" Height="424" MinWidth="640" MinHeight="372"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown" AutomationProperties.Name="Sonar Mini Mixer"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <local:ConnectionBrushConverter x:Key="ConnectionBrushConverter"/>
    <local:LevelFillHeightConverter x:Key="LevelFillHeight"/>
    <local:ResponsiveMetricConverter x:Key="Responsive"/>
    <Style x:Key="MuteButton" TargetType="ToggleButton">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource CapBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CapEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="MuteChrome" CornerRadius="15"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="18" Height="18">
                  <Grid x:Name="SpeakerIcon">
                    <Path Data="M2,7 L6,7 L10,3 L10,15 L6,11 L2,11 Z" Fill="{TemplateBinding Foreground}"/>
                    <Path x:Name="SoundWaves" Data="M12,6 C14,8 14,10 12,12 M14,4 C17,7 17,11 14,14"
                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Grid>
                  <Grid x:Name="MicIcon" Visibility="Collapsed">
                    <Path Data="M9,2 C10.4,2 11.5,3.1 11.5,4.5 L11.5,9 C11.5,10.4 10.4,11.5 9,11.5 C7.6,11.5 6.5,10.4 6.5,9 L6.5,4.5 C6.5,3.1 7.6,2 9,2 Z"
                          Fill="{TemplateBinding Foreground}"/>
                    <Path x:Name="MicStand" Data="M4.6,8.6 C4.6,13 13.4,13 13.4,8.6 M9,13.4 L9,16 M6.4,16 L11.6,16"
                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Grid>
                  <Path x:Name="MuteSlash" Data="M3,3 L15,15" Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Visibility="Collapsed"/>
                </Grid>
              </Viewbox>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMicrophone}" Value="True">
                <Setter TargetName="SpeakerIcon" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="MicIcon" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MuteChrome" Property="Background" Value="{StaticResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="MuteChrome" Property="Background" Value="{StaticResource PressedBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SoundWaves" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="MicStand" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="MuteSlash" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter TargetName="MuteChrome" Property="Background" Value="{StaticResource DangerBrush}"/>
                <Setter TargetName="MuteChrome" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="MuteChrome" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                <Setter TargetName="MuteChrome" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChannelComboBoxItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource PressedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChannelComboBox" TargetType="ComboBox">
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinWidth" Value="76"/>
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource ChannelComboBoxItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" Tag="{TemplateBinding Tag}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SelectorChrome" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            CornerRadius="4">
                      <Grid Margin="1,0,3,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="11"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SelectedText" Text="{TemplateBinding Tag}"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                   FontFamily="Segoe UI, Segoe UI Variable Text" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"/>
                        <Path x:Name="Chevron" Grid.Column="1" Data="M1,2.5 L4.5,6 L8,2.5" Stroke="{StaticResource DimTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="SelectorChrome" Property="Background" Value="{StaticResource HoverBrush}"/>
                        <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextBrush}"/>
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="SelectorChrome" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5" MinWidth="108" MaxHeight="230" Margin="0,3,0,0">
                  <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="VerticalFader" TargetType="Slider">
      <Setter Property="Orientation" Value="Vertical"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="SmallChange" Value="1"/>
      <Setter Property="LargeChange" Value="5"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <EventSetter Event="PreviewMouseWheel" Handler="Slider_PreviewMouseWheel"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Border x:Name="FaderFocus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
              <Grid Margin="0,2">
                <Border x:Name="FaderGroove" Width="12" CornerRadius="4.5" Background="{StaticResource GrooveBrush}"
                        BorderBrush="{StaticResource GrooveEdgeBrush}" BorderThickness="1"
                        VerticalAlignment="Stretch" HorizontalAlignment="Center" Margin="0,7"/>
                <Border x:Name="FaderFill" Width="12" CornerRadius="4.5" Background="{Binding Accent}"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,7"
                        SnapsToDevicePixels="True">
                  <Border.Height>
                    <MultiBinding Converter="{StaticResource LevelFillHeight}">
                      <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <Binding Path="ActualHeight" ElementName="FaderGroove"/>
                    </MultiBinding>
                  </Border.Height>
                </Border>
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="False"
                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                  <Track.DecreaseRepeatButton>
                    <local:MixerTrackButton Command="Slider.DecreaseLarge" Focusable="False">
                      <local:MixerTrackButton.Template>
                        <ControlTemplate TargetType="local:MixerTrackButton"><Border Background="Transparent"/></ControlTemplate>
                      </local:MixerTrackButton.Template>
                    </local:MixerTrackButton>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="28" Height="12" Cursor="SizeNS">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Grid>
                            <Border x:Name="FaderThumb" CornerRadius="4" Background="{StaticResource CapBrush}"
                                    BorderBrush="{StaticResource CapEdgeBrush}" BorderThickness="1"/>
                            <Border x:Name="ThumbGrip" Height="2" Width="12" CornerRadius="1"
                                    Background="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="FaderThumb" Property="Background" Value="{StaticResource CapHoverBrush}"/>
                              <Setter TargetName="FaderThumb" Property="BorderBrush" Value="{Binding Accent}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                              <Setter TargetName="FaderThumb" Property="Background" Value="{StaticResource CapHoverBrush}"/>
                              <Setter TargetName="FaderThumb" Property="BorderBrush" Value="{Binding Accent}"/>
                              <Setter TargetName="ThumbGrip" Property="Width" Value="14"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <local:MixerTrackButton Command="Slider.IncreaseLarge" Focusable="False">
                      <local:MixerTrackButton.Template>
                        <ControlTemplate TargetType="local:MixerTrackButton"><Border Background="Transparent"/></ControlTemplate>
                      </local:MixerTrackButton.Template>
                    </local:MixerTrackButton>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="FaderFocus" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Crossfader" TargetType="Slider">
      <Setter Property="Height" Value="32"/>
      <Setter Property="SmallChange" Value="1"/>
      <Setter Property="LargeChange" Value="5"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <EventSetter Event="PreviewMouseWheel" Handler="Slider_PreviewMouseWheel"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Border x:Name="CrossfaderFocus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
              <Grid Margin="4,0">
                <Border Height="8" CornerRadius="4" Background="{StaticResource GrooveBrush}"
                        BorderBrush="{StaticResource GrooveEdgeBrush}" BorderThickness="1" VerticalAlignment="Center"/>
                <Border Width="2" Height="14" CornerRadius="1" Background="{StaticResource BorderBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False"
                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                  <Track.DecreaseRepeatButton>
                    <local:MixerTrackButton Command="Slider.DecreaseLarge" Focusable="False">
                      <local:MixerTrackButton.Template>
                        <ControlTemplate TargetType="local:MixerTrackButton"><Border Background="Transparent"/></ControlTemplate>
                      </local:MixerTrackButton.Template>
                    </local:MixerTrackButton>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="14" Height="24" Cursor="SizeWE">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border x:Name="CrossThumb" CornerRadius="5" Background="{StaticResource CapBrush}"
                                  BorderBrush="{StaticResource ChatMixBrush}" BorderThickness="1.5">
                            <Rectangle Width="2" Height="10" RadiusX="1" RadiusY="1"
                                       Fill="{StaticResource ChatMixBrush}" HorizontalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="CrossThumb" Property="Background" Value="{StaticResource CapHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                              <Setter TargetName="CrossThumb" Property="Background" Value="{StaticResource CapHoverBrush}"/>
                              <Setter TargetName="CrossThumb" Property="BorderThickness" Value="2"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <local:MixerTrackButton Command="Slider.IncreaseLarge" Focusable="False">
                      <local:MixerTrackButton.Template>
                        <ControlTemplate TargetType="local:MixerTrackButton"><Border Background="Transparent"/></ControlTemplate>
                      </local:MixerTrackButton.Template>
                    </local:MixerTrackButton>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="CrossfaderFocus" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="RootChrome" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1" CornerRadius="9" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="{Binding ActualHeight, ElementName=RootChrome, Converter={StaticResource Responsive}, ConverterParameter='42,46,54'}"/>
        <RowDefinition Height="*" MinHeight="200"/>
        <RowDefinition Height="{Binding ActualHeight, ElementName=RootChrome, Converter={StaticResource Responsive}, ConverterParameter='52,58,70'}"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="9,9,0,0"
              BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="13,0,7,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Width="24" Height="24" Source="Assets/AppMark.png" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
            <TextBlock Text="Sonar Mini Mixer" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Ellipse Width="6" Height="6" Fill="{Binding Connected, Converter={StaticResource ConnectionBrushConverter}}" Margin="9,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding StatusDetail}" Foreground="{StaticResource MutedTextBrush}"
                     FontFamily="Segoe UI, Segoe UI Variable Text" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="250"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding StatusDetail}" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PinButton" Style="{StaticResource ChromeButton}" Content="◇" Click="Pin_Click"
                    ToolTip="Pin and keep open" AutomationProperties.Name="Pin mixer" Margin="0,0,2,0"/>
            <Button Style="{StaticResource ChromeButton}" Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Settings" Margin="0,0,2,0"
                    Content="⚙" FontFamily="Segoe UI Symbol" FontSize="15"/>
            <Button Style="{StaticResource ChromeButton}" Click="Hide_Click" ToolTip="Hide mixer" AutomationProperties.Name="Hide mixer">
              <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                    StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <ItemsControl Grid.Row="1" ItemsSource="{Binding Channels}" IsEnabled="{Binding CanControl}" Margin="12,10,12,6"
                    HorizontalContentAlignment="Stretch">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border Margin="3,0" CornerRadius="7" Padding="5,0" Background="{StaticResource SurfaceBrush}"
                  MaxHeight="480" VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch">
              <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="{Binding ActualHeight, ElementName=RootChrome, Converter={StaticResource Responsive}, ConverterParameter='27,28,32'}"/>
                <RowDefinition Height="{Binding ActualHeight, ElementName=RootChrome, Converter={StaticResource Responsive}, ConverterParameter='42,42,46'}"/>
                <RowDefinition Height="*" MinHeight="72"/>
                <RowDefinition Height="{Binding ActualHeight, ElementName=RootChrome, Converter={StaticResource Responsive}, ConverterParameter='26,30,36'}"/>
                <RowDefinition Height="{Binding ActualHeight, ElementName=RootChrome, Converter={StaticResource Responsive}, ConverterParameter='30,34,40'}"/>
                <RowDefinition Height="{Binding ActualHeight, ElementName=RootChrome, Converter={StaticResource Responsive}, ConverterParameter='38,40,46'}"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Height="3" Background="{Binding Accent}" CornerRadius="0,0,2,2"/>
              <!-- Sonar reports this route as not running. Colour alone is unreadable
                   against a channel's own accent, so show an explicit warning badge. -->
              <Border Grid.Row="0" Height="3" Background="{StaticResource DangerBrush}" CornerRadius="0,0,2,2"
                      Visibility="{Binding RouteStalled, Converter={StaticResource BoolVisibility}}"/>
              <StackPanel Grid.Row="1" Orientation="Horizontal"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{StaticResource DangerBrush}" CornerRadius="3" Padding="4,0" Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding RouteStalled, Converter={StaticResource BoolVisibility}}"
                        ToolTip="{Binding RouteStatusTip}">
                  <TextBlock Text="!" Foreground="White" FontFamily="Segoe UI, Segoe UI Variable Display"
                             FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"
                           FontSize="{Binding ActualHeight, ElementName=RootChrome, Converter={StaticResource Responsive}, ConverterParameter='13,14,16.5'}"
                           VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RouteStalled}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
              <StackPanel Grid.Row="2" Margin="1,0,1,5" VerticalAlignment="Bottom"
                          Visibility="{Binding HasChannelOptions, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="EQ PRESET" Foreground="{StaticResource DimTextBrush}" FontFamily="Segoe UI Semibold, Segoe UI" FontSize="9.5" FontWeight="SemiBold"
                           Margin="1,0,0,2" Opacity="0.95"/>
                <ComboBox Style="{StaticResource ChannelComboBox}" ItemsSource="{Binding Presets}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          Tag="{Binding SelectedPresetName}"
                          SelectedValue="{Binding SelectedPresetId, Mode=OneWay}" SelectionChanged="Preset_SelectionChanged"
                          ToolTip="{Binding SelectedPresetName}"
                          AutomationProperties.Name="{Binding Name, StringFormat={}{0} preset}"
                          AutomationProperties.HelpText="{Binding SelectedPresetName}"/>
              </StackPanel>
              <TextBlock Grid.Row="2" Text="ALL CHANNELS" Foreground="{StaticResource DimTextBrush}"
                         FontFamily="Segoe UI Semibold, Segoe UI" FontSize="9.5" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding IsMaster, Converter={StaticResource BoolVisibility}}"/>
              <Slider Grid.Row="3" Style="{StaticResource VerticalFader}" MaxHeight="{Binding ActualHeight, ElementName=RootChrome, Converter={StaticResource Responsive}, ConverterParameter='140,175,240'}"
                      Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="{Binding Name, StringFormat={}{0} volume}"
                      AutomationProperties.HelpText="Use arrow keys to change volume" HorizontalAlignment="Center"/>
              <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding VolumeText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                           FontSize="{Binding ActualHeight, ElementName=RootChrome, Converter={StaticResource Responsive}, ConverterParameter='17,19,23'}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                <TextBlock Text="%" Foreground="{StaticResource DimTextBrush}" FontFamily="Segoe UI Semibold, Segoe UI"
                           FontSize="11" FontWeight="SemiBold" Margin="2,0,0,3" VerticalAlignment="Bottom"/>
              </StackPanel>
              <ToggleButton Grid.Row="5" Style="{StaticResource MuteButton}" Click="Mute_Click"
                            IsChecked="{Binding Muted, Mode=OneWay}"
                            ToolTip="{Binding MuteAction}" AutomationProperties.Name="{Binding MuteAction}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <StackPanel Grid.Row="6" Margin="1,5,1,0" VerticalAlignment="Top"
                          Visibility="{Binding HasChannelOptions, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding DeviceRoleLabel}" Foreground="{StaticResource DimTextBrush}" FontFamily="Segoe UI Semibold, Segoe UI" FontSize="9.5" FontWeight="SemiBold"
                           Margin="1,0,0,2" Opacity="0.95"/>
                <ComboBox Style="{StaticResource ChannelComboBox}" ItemsSource="{Binding Devices}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          Tag="{Binding SelectedDeviceName}"
                          SelectedValue="{Binding SelectedDeviceId, Mode=OneWay}" SelectionChanged="Device_SelectionChanged"
                          ToolTip="{Binding RouteStatusTip}"
                          AutomationProperties.Name="{Binding Name, StringFormat={}{0} physical device}"
                          AutomationProperties.HelpText="{Binding RouteStatusTip}"/>
              </StackPanel>
              <StackPanel Grid.Row="6" Margin="1,5,1,0" VerticalAlignment="Top"
                          Visibility="{Binding IsMaster, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="ALL OUTPUTS" Foreground="{StaticResource DimTextBrush}" FontFamily="Segoe UI Semibold, Segoe UI" FontSize="9.5" FontWeight="SemiBold"
                           Margin="1,0,0,2" Opacity="0.95"/>
                <ComboBox Style="{StaticResource ChannelComboBox}" ItemsSource="{Binding Devices}"
                          DisplayMemberPath="Name" SelectedValuePath="Id" Tag="{Binding SelectedDeviceName}"
                          SelectedValue="{Binding SelectedDeviceId, Mode=OneWay}" SelectionChanged="Device_SelectionChanged"
                          ToolTip="Change Game, Chat, Media, and Aux together"
                          AutomationProperties.Name="All playback outputs"
                          AutomationProperties.HelpText="Changes Game, Chat, Media, and Aux together"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,9,9"
              BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="15,6,13,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ChatMix" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="Game  —  Chat" Foreground="{StaticResource MutedTextBrush}" FontFamily="Segoe UI Semibold, Segoe UI" FontSize="10" Margin="0,2,0,0"/>
          </StackPanel>
          <Slider Grid.Column="1" Style="{StaticResource Crossfader}" Minimum="-100" Maximum="100"
                  Value="{Binding ChatMix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsMoveToPointEnabled="True" IsEnabled="{Binding CanControlChatMix}" Margin="8,0"
                  VerticalAlignment="Center" AutomationProperties.Name="Game and chat balance"/>
          <TextBlock Grid.Column="2" Text="{Binding ChatMix, StringFormat={}{0:+0;-0;0}}" Foreground="{StaticResource MutedTextBrush}"
                     FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="SemiBold"
                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Content="RESET" Click="CenterChatMix_Click"
                  IsEnabled="{Binding CanControlChatMix}" Height="28" Padding="9,0" FontSize="10"
                  ToolTip="Reset ChatMix to center" AutomationProperties.Name="Center ChatMix"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
